{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",
    "resolveJsonModule": true,
    "types": ["bun", "node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  }
}
