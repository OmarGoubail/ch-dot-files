  "tests": [
    {
      "id": "happy-transfer",
      "kind": "integration",
      "title": "moves money and records entries",
      "scenario": "happy path",
      "file": "test/shop_web/controllers/transfer_controller_test.exs",
      "startLine": 4,
      "code": [
        "test \"moves money and records entries\", %{conn: conn} do",
        "  sender = account_fixture(balance: Money.new(100, :USD))",
        "  receiver = account_fixture(balance: Money.new(20, :USD))",
        "  params = transfer_params(sender, receiver, 30, \"req-101\")",
        "",
        "  conn = post(conn, ~p\"/api/transfers\", transfer: params)",
        "",
        "  assert %{\"id\" => transfer_id} = json_response(conn, 201)",
        "  assert Accounts.balance(sender) == Money.new(70, :USD)",
        "  assert Accounts.balance(receiver) == Money.new(50, :USD)",
        "  assert Ledger.kinds(transfer_id) == [:debit, :credit]",
        "end"
      ],
      "setup": [
        "Create a sender with $100.00.",
        "Create a receiver with $20.00.",
        "Request a transfer of $30.00."
      ],
      "action": "Send one POST request to the transfer endpoint.",
      "checks": [
        "The response has status 201 and a transfer ID.",
        "The sender has $70.00 and the receiver has $50.00.",
        "The ledger has one debit and one credit."
      ],
      "limits": [
        "It does not run two transfers at the same time.",
        "It does not prove the insufficient-funds path."
      ]
    },
    {
      "id": "insufficient-funds",
      "kind": "integration",
      "title": "does not move money without funds",
      "scenario": "failure path",
      "file": "test/shop_web/controllers/transfer_controller_test.exs",
      "startLine": 17,
      "code": [
        "test \"does not move money without funds\", %{conn: conn} do",
        "  sender = account_fixture(balance: Money.new(10, :USD))",
        "  receiver = account_fixture(balance: Money.new(20, :USD))",
        "  params = transfer_params(sender, receiver, 25, \"req-102\")",
        "",
        "  conn = post(conn, ~p\"/api/transfers\", transfer: params)",
        "",
        "  assert %{\"error\" => \"insufficient_funds\"} = json_response(conn, 422)",
        "  assert {Money.new(10, :USD), Money.new(20, :USD)} == balances(sender, receiver)",
        "  refute Ledger.exists_for_key?(\"req-102\")",
        "end"
      ],
      "setup": [
        "Create a sender with $10.00.",
        "Create a receiver with $20.00.",
        "Request a transfer of $25.00."
      ],
      "action": "Send one POST request to the transfer endpoint.",
      "checks": [
        "The response has status 422 and the insufficient_funds error.",
        "Both balances stay unchanged.",
        "The ledger has no record for this request."
      ],
      "limits": [
        "It does not prove that row locks prevent a concurrent overspend.",
        "It does not test other transaction failures."
      ]
    }
  ],
