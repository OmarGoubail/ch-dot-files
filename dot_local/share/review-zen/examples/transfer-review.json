{
  "schemaVersion": 1,
  "title": "Add safe account transfers",
  "diff": [
    "diff --git a/lib/shop_web/controllers/transfer_controller.ex b/lib/shop_web/controllers/transfer_controller.ex",
    "new file mode 100644",
    "index 0000000..a811d91",
    "--- /dev/null",
    "+++ b/lib/shop_web/controllers/transfer_controller.ex",
    "@@ -0,0 +1,22 @@",
    "+defmodule ShopWeb.TransferController do",
    "+  use ShopWeb, :controller",
    "+",
    "+  alias Shop.Transfers",
    "+",
    "+  def create(conn, %{\"transfer\" => params}) do",
    "+    case Transfers.transfer(params) do",
    "+      {:ok, transfer} ->",
    "+        conn",
    "+        |> put_status(:created)",
    "+        |> render(:show, transfer: transfer)",
    "+",
    "+      {:error, :insufficient_funds} ->",
    "+        conn",
    "+        |> put_status(:unprocessable_entity)",
    "+        |> json(%{error: \"insufficient_funds\"})",
    "+    end",
    "+  end",
    "+end",
    "diff --git a/lib/shop/transfers.ex b/lib/shop/transfers.ex",
    "new file mode 100644",
    "index 0000000..352d4ef",
    "--- /dev/null",
    "+++ b/lib/shop/transfers.ex",
    "@@ -0,0 +1,35 @@",
    "+defmodule Shop.Transfers do",
    "+  alias Shop.Accounts",
    "+  alias Shop.Ledger",
    "+  alias Shop.Money",
    "+  alias Shop.Repo",
    "+  alias Shop.Transfers.Transfer",
    "+  alias Shop.Transfers.TransferCommand",
    "+",
    "+  def transfer(attrs) do",
    "+    with {:ok, command} <- TransferCommand.cast(attrs) do",
    "+      find_or_execute(command)",
    "+    end",
    "+  end",
    "+",
    "+  defp find_or_execute(command) do",
    "+    case Repo.get_by(Transfer, idempotency_key: command.idempotency_key) do",
    "+      nil -> execute(command)",
    "+      transfer -> {:ok, transfer}",
    "+    end",
    "+  end",
    "+",
    "+  defp execute(command) do",
    "+    Repo.transaction(fn ->",
    "+      with {:ok, from, to} <-",
    "+             Accounts.lock_pair(command.from_id, command.to_id),",
    "+           :ok <- Money.ensure_available(from.balance, command.amount),",
    "+           {:ok, _accounts} <- Accounts.move(from, to, command.amount),",
    "+           {:ok, transfer} <- Ledger.record(command) do",
    "+        transfer",
    "+      else",
    "+        {:error, reason} -> Repo.rollback(reason)",
    "+      end",
    "+    end)",
    "+  end",
    "+end",
    "diff --git a/test/shop_web/controllers/transfer_controller_test.exs b/test/shop_web/controllers/transfer_controller_test.exs",
    "new file mode 100644",
    "index 0000000..fe32092",
    "--- /dev/null",
    "+++ b/test/shop_web/controllers/transfer_controller_test.exs",
    "@@ -0,0 +1,32 @@",
    "+defmodule ShopWeb.TransferControllerTest do",
    "+  use ShopWeb.ConnCase",
    "+",
    "+  test \"moves money and records entries\", %{conn: conn} do",
    "+    sender = account_fixture(balance: Money.new(100, :USD))",
    "+    receiver = account_fixture(balance: Money.new(20, :USD))",
    "+    params = transfer_params(sender, receiver, 30, \"req-101\")",
    "+",
    "+    conn = post(conn, ~p\"/api/transfers\", transfer: params)",
    "+",
    "+    assert %{\"id\" => transfer_id} = json_response(conn, 201)",
    "+    assert Accounts.balance(sender) == Money.new(70, :USD)",
    "+    assert Accounts.balance(receiver) == Money.new(50, :USD)",
    "+    assert Ledger.kinds(transfer_id) == [:debit, :credit]",
    "+  end",
    "+",
    "+  test \"does not move money without funds\", %{conn: conn} do",
    "+    sender = account_fixture(balance: Money.new(10, :USD))",
    "+    receiver = account_fixture(balance: Money.new(20, :USD))",
    "+    params = transfer_params(sender, receiver, 25, \"req-102\")",
    "+",
    "+    conn = post(conn, ~p\"/api/transfers\", transfer: params)",
    "+",
    "+    assert %{\"error\" => \"insufficient_funds\"} = json_response(conn, 422)",
    "+    assert {Money.new(10, :USD), Money.new(20, :USD)} == balances(sender, receiver)",
    "+    refute Ledger.exists_for_key?(\"req-102\")",
    "+  end",
    "+end"
  ],
