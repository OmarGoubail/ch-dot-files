  "tests": [
    {
      "id": "renders",
      "kind": "server-dom",
      "title": "renders streamed items and total",
      "scenario": "connected render",
      "file": "test/shop_web/live/checkout_live_test.exs",
      "startLine": 12,
      "code": [
        "{:ok, view, _html} = live(conn, ~p\"/checkout\")",
        "assert has_element?(view, \"#line-items-123\", \"Keyboard\")",
        "assert has_element?(view, \"#order-total\", \"$24.00\")"
      ],
      "setup": [
        "Create a cart with two items."
      ],
      "action": "Connect the checkout LiveView.",
      "checks": [
        "The server DOM has the streamed item and total."
      ],
      "limits": [
        "It does not run JavaScript or prove CSS layout."
      ]
    },
    {
      "id": "invalid",
      "kind": "server-dom",
      "title": "shows validation errors",
      "scenario": "delivery fields are empty",
      "file": "test/shop_web/live/checkout_live_test.exs",
      "startLine": 22,
      "code": [
        "view |> form(\"#checkout-form\", order: %{email: \"\"}) |> render_submit()",
        "assert has_element?(view, \"#checkout-errors[role=alert]\")",
        "refute_receive {:order_started, _}"
      ],
      "setup": [
        "Connect checkout with empty delivery fields."
      ],
      "action": "Submit the form.",
      "checks": [
        "The server DOM has an alert.",
        "No order task starts."
      ],
      "limits": [
        "It does not prove browser focus."
      ]
    },
    {
      "id": "success",
      "kind": "server-dom",
      "title": "shows confirmation after async success",
      "scenario": "order creation succeeds",
      "file": "test/shop_web/live/checkout_live_test.exs",
      "startLine": 31,
      "code": [
        "view |> form(\"#checkout-form\", order: valid_params()) |> render_submit()",
        "render_async(view)",
        "assert has_element?(view, \"#order-confirmation[role=status]\", \"A-42\")"
      ],
      "setup": [
        "Make order creation return A-42."
      ],
      "action": "Submit and wait for async work.",
      "checks": [
        "The server DOM has confirmation A-42."
      ],
      "limits": [
        "It does not prove payment settlement."
      ]
    },
    {
      "id": "failure",
      "kind": "server-dom",
      "title": "recovers after task exit",
      "scenario": "order creation times out",
      "file": "test/shop_web/live/checkout_live_test.exs",
      "startLine": 40,
      "code": [
        "view |> form(\"#checkout-form\", order: valid_params()) |> render_submit()",
        "render_async(view)",
        "assert render(view) =~ \"We could not place your order\"",
        "assert has_element?(view, \"button:not([disabled])\")"
      ],
      "setup": [
        "Make the order task exit."
      ],
      "action": "Submit and wait for async work.",
      "checks": [
        "The flash explains the failure.",
        "The button is available again."
      ],
      "limits": [
        "It does not retry."
      ]
    },
    {
      "id": "focus",
      "kind": "browser",
      "title": "moves focus to the error summary",
      "scenario": "validation inserts an alert",
      "file": "test/browser/checkout_test.exs",
      "startLine": 8,
      "code": [
        "session |> visit(\"/checkout\") |> click(button(\"Place order\"))",
        "assert session |> active_element() |> attribute(\"id\") == \"checkout-errors\""
      ],
      "setup": [
        "Open checkout in a browser."
      ],
      "action": "Submit invalid data.",
      "checks": [
        "The browser active element is checkout-errors."
      ],
      "limits": [
        "It does not prove screen-reader speech."
      ]
    }
  ],
