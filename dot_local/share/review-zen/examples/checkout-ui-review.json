{
  "schemaVersion": 1,
  "title": "Add a LiveView checkout flow",
  "diff": [
    "diff --git a/lib/shop_web/live/checkout_live.ex b/lib/shop_web/live/checkout_live.ex",
    "new file mode 100644",
    "--- /dev/null",
    "+++ b/lib/shop_web/live/checkout_live.ex",
    "@@ -0,0 +20,51 @@",
    "+def render(assigns) do",
    "+  ~H\"\"\"",
    "+  <Layouts.app flash={@flash}>",
    "+    <main id=\"checkout-page\">",
    "+      <.header>",
    "+        Checkout",
    "+        <:subtitle>Confirm your delivery details.</:subtitle>",
    "+      </.header>",
    "+",
    "+      <.form for={@form} id=\"checkout-form\" phx-change=\"validate\" phx-submit=\"save\">",
    "+        <div class=\"checkout-grid\">",
    "+          <section aria-labelledby=\"delivery-heading\">",
    "+            <h2 id=\"delivery-heading\">Delivery</h2>",
    "+            <.input field={@form[:email]} type=\"email\" label=\"Email\" />",
    "+            <.input field={@form[:address]} label=\"Address\" />",
    "+            <.input field={@form[:city]} label=\"City\" />",
    "+          </section>",
    "+",
    "+          <aside aria-labelledby=\"summary-heading\">",
    "+            <h2 id=\"summary-heading\">Order summary</h2>",
    "+            <ul id=\"line-items\" phx-update=\"stream\">",
    "+              <li :for={{dom_id, item} <- @streams.items} id={dom_id}>",
    "+                <span>{item.name}</span>",
    "+                <span>{item.quantity} × {Money.to_string(item.price)}</span>",
    "+              </li>",
    "+            </ul>",
    "+            <p id=\"order-total\" aria-live=\"polite\">",
    "+              Total: {Money.to_string(@total)}",
    "+            </p>",
    "+          </aside>",
    "+        </div>",
    "+",
    "+        <.error_summary :if={@form.source.action} errors={@form.errors} />",
    "+",
    "+        <div class=\"checkout-actions\">",
    "+          <.link navigate={~p\"/cart\"}>Return to cart</.link>",
    "+          <.button disabled={@submitting} phx-disable-with=\"Placing order…\">",
    "+            <span :if={@submitting}>Placing order…</span>",
    "+            <span :if={!@submitting}>Place order</span>",
    "+          </.button>",
    "+        </div>",
    "+      </.form>",
    "+",
    "+      <section :if={@order} id=\"order-confirmation\" role=\"status\">",
    "+        <h2>Order placed</h2>",
    "+        <p>Order {@order.number} is complete.</p>",
    "+      </section>",
    "+    </main>",
    "+  </Layouts.app>",
    "+  \"\"\"",
    "+end",
    "diff --git a/lib/shop_web/live/checkout_live.ex b/lib/shop_web/live/checkout_live.ex",
    "new file mode 100644",
    "--- /dev/null",
    "+++ b/lib/shop_web/live/checkout_live.ex",
    "@@ -0,0 +80,28 @@",
    "+def handle_event(\"validate\", %{\"order\" => params}, socket) do",
    "+  form = %Order{} |> Checkout.change_order(params) |> Map.put(:action, :validate) |> to_form()",
    "+  {:noreply, assign(socket, :form, form)}",
    "+end",
    "+",
    "+def handle_event(\"save\", %{\"order\" => params}, socket) do",
    "+  changeset = Checkout.change_order(%Order{}, params)",
    "+",
    "+  if changeset.valid? do",
    "+    {:noreply,",
    "+     socket",
    "+     |> assign(:submitting, true)",
    "+     |> start_async(:place_order, fn -> Checkout.place_order(params) end)}",
    "+  else",
    "+    {:noreply, assign(socket, :form, to_form(%{changeset | action: :insert}))}",
    "+  end",
    "+end",
    "+",
    "+def handle_async(:place_order, {:ok, {:ok, order}}, socket) do",
    "+  {:noreply, socket |> assign(:order, order) |> assign(:submitting, false)}",
    "+end",
    "+",
    "+def handle_async(:place_order, {:exit, _reason}, socket) do",
    "+  {:noreply,",
    "+   socket",
    "+   |> put_flash(:error, \"We could not place your order. Try again.\")",
    "+   |> assign(:submitting, false)}",
    "+end",
    "diff --git a/lib/shop_web/components/checkout_components.ex b/lib/shop_web/components/checkout_components.ex",
    "new file mode 100644",
    "--- /dev/null",
    "+++ b/lib/shop_web/components/checkout_components.ex",
    "@@ -0,0 +10,10 @@",
    "+attr :errors, :list, required: true",
    "+",
    "+def error_summary(assigns) do",
    "+  ~H\"\"\"",
    "+  <div id=\"checkout-errors\" role=\"alert\" tabindex=\"-1\" phx-hook=\"FocusError\">",
    "+    <h2>Check your order</h2>",
    "+    <p :for={{message, _meta} <- @errors}>{message}</p>",
    "+  </div>",
    "+  \"\"\"",
    "+end",
    "diff --git a/assets/js/hooks/focus_error.ts b/assets/js/hooks/focus_error.ts",
    "new file mode 100644",
    "--- /dev/null",
    "+++ b/assets/js/hooks/focus_error.ts",
    "@@ -0,0 +1,9 @@",
    "+export const FocusError = {",
    "+  mounted() {",
    "+    this.el.focus()",
    "+  },",
    "+",
    "+  updated() {",
    "+    this.el.focus()",
    "+  },",
    "+}",
    "diff --git a/assets/css/checkout.css b/assets/css/checkout.css",
    "new file mode 100644",
    "--- /dev/null",
    "+++ b/assets/css/checkout.css",
    "@@ -0,0 +1,16 @@",
    "+.checkout-grid {",
    "+  display: grid;",
    "+  grid-template-columns: minmax(0, 1fr) 22rem;",
    "+  gap: 2rem;",
    "+}",
    "+",
    "+@media (max-width: 48rem) {",
    "+  .checkout-grid {",
    "+    grid-template-columns: 1fr;",
    "+  }",
    "+",
    "+  .checkout-actions {",
    "+    position: sticky;",
    "+    bottom: 0;",
    "+  }",
    "+}"
  ],
