      "id": "error-summary",
      "file": "lib/shop_web/components/checkout_components.ex",
      "symbol": "error_summary/1",
      "diff": [
        "diff --git a/lib/shop_web/components/checkout_components.ex b/lib/shop_web/components/checkout_components.ex",
        "new file mode 100644",
        "--- /dev/null",
        "+++ b/lib/shop_web/components/checkout_components.ex",
        "@@ -0,0 +10,10 @@",
        "+attr :errors, :list, required: true",
        "+",
        "+def error_summary(assigns) do",
